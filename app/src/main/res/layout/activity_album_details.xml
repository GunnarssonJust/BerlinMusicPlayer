<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/breitscheid"
    tools:context=".AlbumDetails">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/frag_bottom_player"
        tools:layout="@layout/fragment_now_playing_bottom"
        android:name="com.berlinmusicplayer.NowPlayingFragmentBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:layout_marginBottom="1dp"
        android:background="#99000000"/>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/frag_bottom_player"
        >
        <ImageView
            android:id="@+id/albumPhoto"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/ic_play_btn"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            />
        <TextView
            android:id="@+id/album_name"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/albumPhoto"
            android:text="@string/album"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            />

        <TextView
            android:id="@+id/artist"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/album_name"
            android:text="@string/artist"
            android:textColor="@color/white"
            android:gravity="center"
            />

        <TextView
            android:id="@+id/album_details_year"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_below="@+id/artist"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="69dp"
            android:layout_marginBottom="2dp"
            android:layout_toStartOf="@+id/album_details_duration"
            android:gravity="center"
            android:text="@string/year"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/album_details_duration"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_below="@+id/artist"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="134dp"
            android:layout_marginBottom="2dp"
            android:gravity="center"
            android:text="@string/duration"
            android:textColor="@color/white" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/album_recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/album_details_year"
            android:layout_marginTop="10dp"
            />
    </RelativeLayout>


</RelativeLayout>