<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">
 
    <!-- Künstler-Bild oben -->
    <ImageView
        android:id="@+id/artistPhoto"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
 
    <!-- Künstler-Name -->
    <TextView
        android:id="@+id/artistTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/artistPhoto"
        app:layout_constraintStart_toStartOf="parent"/>
 
    <!-- TabLayout: Alben | Titel -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/artist_tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        app:tabTextColor="@color/white"
        app:tabSelectedTextColor="@color/darkgreen"
        app:tabIndicatorColor="@color/darkgreen"
        app:tabTextAppearance="@android:style/TextAppearance.Medium"
        app:layout_constraintTop_toBottomOf="@id/artistTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
 
    <!-- ViewPager2 für die Fragments -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/artist_viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/artist_tabLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
 
</androidx.constraintlayout.widget.ConstraintLayout>