<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:background="@drawable/miniplayer_background">

    <!-- Albumcover -->

    <ImageView
        android:id="@+id/image_view_album"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="12dp"
        android:layout_centerVertical="true"
        android:scaleType="centerCrop"/>

    <!-- Titel -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/text_view_name"
        android:layout_toEndOf="@id/image_view_album"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="17sp"
        android:maxLines="1"/>

    <!-- Artist -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:id="@+id/text_view_artist"
        android:layout_below="@id/text_view_name"
        android:layout_toEndOf="@id/image_view_album"
        android:layout_marginStart="12dp"
        android:textColor="#B0FFFFFF"
        android:textSize="14sp"
        android:maxLines="1"/>

    <!-- Skyline -->

    <ImageView
        android:id="@+id/image_skyline"
        android:layout_width="220dp"
        android:layout_height="22dp"
        android:layout_below="@id/text_view_artist"
        android:layout_toEndOf="@id/image_view_album"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_seekbar_ampelmann"
        android:alpha="0.55"/>

    <!-- Buttons -->

    <LinearLayout
        android:id="@+id/layout_controls"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/button_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_notif_backward"/>

        <ImageButton
            android:id="@+id/button_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_notif_play"/>

        <ImageButton
            android:id="@+id/button_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_notif_forward"/>

        <ImageButton
            android:id="@+id/button_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_notif_remove"/>

    </LinearLayout>

</RelativeLayout>