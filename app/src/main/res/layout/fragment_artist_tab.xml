<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/im_funkturm_background_small">
 
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tab_recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="#77000000"/>

    <ImageButton
        android:id="@+id/shuffle_all_songs"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="40dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/ic_baseline_panorama_fish_eye_24"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/ic_shuffle_green"
        app:layout_constraintBottom_toBottomOf="@id/tab_recyclerView"
        app:layout_constraintEnd_toEndOf="@id/tab_recyclerView"
        android:contentDescription="@string/action_shuffle_all"/>
</androidx.constraintlayout.widget.ConstraintLayout>