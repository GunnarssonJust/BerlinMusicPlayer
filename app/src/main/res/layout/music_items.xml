<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/audio_item"
    android:minHeight="70dp">

        <!-- ================================================================ -->
        <!-- BLOCK 1: Der linke Block (Cover & Track-Nummer)                    -->
        <!-- Wir verwenden einen simplen FrameLayout als stabilen Anker.        -->
        <!-- ================================================================ -->

        <FrameLayout
            android:id="@+id/left_block_container"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

                <!-- Das ImageView füllt den Container aus -->
                <ImageView
                    android:id="@+id/music_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/ic_launcher_round"
                    android:padding="5dp" />

                <!-- Das TextView füllt ebenfalls den Container aus -->
                <TextView
                    android:id="@+id/music_track_number"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:visibility="gone" />

        </FrameLayout>

        <!-- ================================================================ -->
        <!-- BLOCK 2: Der rechte Anker (Menü-Button)                           -->
        <!-- ================================================================ -->

        <ImageView
            android:id="@+id/menuMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_baer_with_border"
            android:padding="8dp"
            android:layout_marginEnd="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

        <!-- ================================================================ -->
        <!-- BLOCK 3: Der Text-Block, der dazwischen aufgespannt wird         -->
        <!-- Er orientiert sich jetzt am stabilen FrameLayout-Container.       -->
        <!-- ================================================================ -->

        <TextView
            android:id="@+id/music_file_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="Langer Songtitel zum Testen"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            app:layout_constraintStart_toEndOf="@id/left_block_container"
            app:layout_constraintEnd_toStartOf="@id/menuMore"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/artist_file_name"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0.35" />

        <TextView
            android:id="@+id/artist_file_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Künstlername"
            android:textColor="@color/grey"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="@id/music_file_name"
            app:layout_constraintEnd_toEndOf="@id/music_file_name"
            app:layout_constraintTop_toBottomOf="@id/music_file_name"
            app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
