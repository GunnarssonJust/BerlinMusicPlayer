<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mContainer"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_player"
    tools:context=".PlayerActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/player_toolbar"
        android:layout_height="?attr/actionBarSize"
        android:layout_width="match_parent"
        android:background="@color/darkgreen"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/app_name"
        app:titleTextColor="@color/lightred"/>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- VINYL CONTAINER: dreht sich als Ganzes              -->
    <!-- ════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/vinyl_container"
        android:layout_width="280dp"
        android:layout_height="280dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_toolbar"
        app:layout_constraintVertical_bias="0.043"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 1. Vinyl SVG mit Rillen (volle Größe, dreht sich) -->
        <ImageView
            android:id="@+id/vinyl_ring"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center"
            android:src="@drawable/vinyl_record"
            android:contentDescription="@string/albumart"
            android:visibility="invisible"/>

        <!-- 2. Album Cover (rund, zentriert, 152dp = Cover-Bereich im SVG) -->
        <ImageView
            android:id="@+id/album_image"
            android:layout_width="152dp"
            android:layout_height="152dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_play_pressed"
            android:contentDescription="@string/albumart"/>

        <!-- 3. Mittelloch (über dem Cover, 20dp) -->
        <ImageView
            android:id="@+id/vinyl_hole"
            android:visibility="invisible"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/vinyl_center_hole"
            android:contentDescription="@string/albumart"/>

    </FrameLayout>
    <!-- ════════════════════════════════════════════════════ -->
    <!-- TONARM — über vinyl_container, oben rechts          -->
    <!-- Nur sichtbar im Vinyl-Design!                       -->
    <!-- ════════════════════════════════════════════════════ -->
    <ImageView
        android:id="@+id/vinyl_tonearm"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:src="@drawable/vinyl_tonearm"
        android:visibility="invisible"
        android:contentDescription="@string/albumart"
        android:layout_marginEnd="-48dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="@id/vinyl_container"
        app:layout_constraintTop_toTopOf="@id/vinyl_container"/>
    <!-- ════════════════════════════════════════════════════ -->

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="96dp"
        android:layout_marginEnd="8dp"
        android:padding="8dp"
        android:progressDrawable="@drawable/seekbar"
        android:thumb="@drawable/ic_seekbar_ampelmann_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vinyl_container" />

    <TextView
        android:id="@+id/songCurrentDurationLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="4dp"
        android:gravity="start"
        android:text="@string/start_time"
        android:textColor="@color/red"
        app:layout_constraintBottom_toTopOf="@+id/seekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vinyl_container"
        app:layout_constraintVertical_bias="0.894" />

    <ImageView
        android:id="@+id/btn_shuffle"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:contentDescription="@string/shuffle"
        android:src="@drawable/ic_shuffle"
        app:layout_constraintBottom_toTopOf="@+id/seekBar"
        app:layout_constraintEnd_toStartOf="@+id/btn_add_2_playlist"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vinyl_container"
        app:layout_constraintVertical_bias="0.8"/>

    <ImageView
        android:id="@+id/btn_add_2_playlist"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:contentDescription="@string/add_to_playlist"
        android:src="@drawable/ic_add_to_playlist"
        app:layout_constraintBottom_toTopOf="@+id/seekBar"
        app:layout_constraintEnd_toStartOf="@+id/btn_repeat"
        app:layout_constraintStart_toEndOf="@+id/btn_shuffle"
        app:layout_constraintTop_toBottomOf="@+id/vinyl_container"
        app:layout_constraintVertical_bias="0.8"/>

    <ImageView
        android:id="@+id/btn_repeat"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:contentDescription="@string/repeat"
        android:src="@drawable/ic_repeat"
        app:layout_constraintBottom_toTopOf="@+id/seekBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_add_2_playlist"
        app:layout_constraintTop_toBottomOf="@+id/vinyl_container"
        app:layout_constraintVertical_bias="0.8"/>

    <RelativeLayout
        android:id="@+id/RelLayout"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_margin="1dp"
        android:background="@drawable/bg_color_footer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/songArtist">

        <!-- ═══════════════════════════════════════════ -->
        <!-- BERLIN SKYLINE — alle am unteren Rand      -->
        <!-- ═══════════════════════════════════════════ -->

        <!-- Funkturm — ganz links -->
        <ImageView
            android:layout_width="54dp"
            android:layout_height="65dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="0dp"
            android:contentDescription="@string/funkturm"
            android:scaleType="fitXY"
            android:src="@drawable/funkturm" />

        <!-- Gedächtniskirche — links von Mitte (Charlottenburg/West) -->
        <ImageView
            android:id="@+id/gedaechtniskirche"
            android:layout_width="80dp"
            android:layout_height="55dp"
            android:layout_alignParentBottom="true"
            android:layout_toStartOf="@+id/play_pause"
            android:layout_marginEnd="-2dp"
            android:scaleType="fitEnd"
            android:src="@drawable/im_gedaechtniskirche"/>

        <!-- Reichstag — rechts von Mitte (Mitte/Ost) -->
        <ImageView
            android:id="@+id/reichstag"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:layout_alignParentBottom="true"
            android:layout_toEndOf="@+id/play_pause"
            android:layout_marginStart="4dp"
            android:scaleType="fitStart"
            android:src="@drawable/im_reichstag"/>

        <!-- Fernsehturm — ganz rechts -->
        <ImageView
            android:layout_width="50dp"
            android:layout_height="100dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="0dp"
            android:contentDescription="@string/fernsehturm"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_fernsehturm" />

        <!-- ═══════════════════════════════════════════ -->
        <!-- BUTTONS — symmetrisch zentriert            -->
        <!-- ═══════════════════════════════════════════ -->

        <!-- Play/Pause — exakt in der Mitte -->
        <ImageView
            android:id="@+id/play_pause"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@mipmap/ic_play_pressed"/>

        <!-- Previous — links vom Play-Button, gleicher Abstand -->
        <ImageView
            android:id="@+id/rewind"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_centerVertical="true"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="65dp"
            android:layout_toStartOf="@id/play_pause"
            android:contentDescription="@string/rewind"
            android:src="@mipmap/ic_backward"/>

        <!-- Next — rechts vom Play-Button, gleicher Abstand -->
        <ImageView
            android:id="@+id/forward"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_centerVertical="true"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="65dp"
            android:layout_toEndOf="@id/play_pause"
            android:contentDescription="@string/forward"
            android:src="@mipmap/ic_forward"/>

    </RelativeLayout>

    <TextView
        android:id="@+id/songArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="2dp"
        android:ellipsize="marquee"
        android:fontFamily=""
        android:gravity="center"
        android:layoutDirection="ltr"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:singleLine="true"
        android:text="@string/rio_reiser"
        android:textColor="@color/red"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textIsSelectable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/songTitle"
        app:layout_constraintBottom_toTopOf="@id/RelLayout"/>

    <TextView
        android:id="@+id/songTitle"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:ellipsize="marquee"
        android:fontFamily=""
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:text="@string/rauch_haus_song"
        android:textColor="@color/darkgreen"
        android:textIsSelectable="true"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/songArtist"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seekBar" />

    <TextView
        android:id="@+id/songRemainingDurationLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:gravity="end"
        android:text="@string/end"
        android:textColor="@color/darkgreen"
        app:layout_constraintBottom_toTopOf="@+id/seekBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vinyl_container"
        app:layout_constraintVertical_bias="0.835" />

</androidx.constraintlayout.widget.ConstraintLayout>