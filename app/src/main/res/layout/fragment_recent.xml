<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/im_brbg_gate">

    <TextView
        android:id="@+id/recent_empty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Noch keine Songs gespielt"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recent_recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clipToPadding="false"
        android:paddingBottom="80dp"/>

    <ImageButton
        android:id="@+id/shuffle_all_songs"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="40dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/ic_baseline_panorama_fish_eye_24"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/ic_shuffle_green"
        app:layout_constraintBottom_toBottomOf="@id/recent_recyclerView"
        app:layout_constraintEnd_toEndOf="@id/recent_recyclerView"
        android:contentDescription="@string/action_shuffle_all"/>



</androidx.constraintlayout.widget.ConstraintLayout>
