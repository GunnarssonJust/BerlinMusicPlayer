<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_root"
    android:layout_width="300dp"
    android:layout_height="120dp"
    android:background="@drawable/miniplayer_background"
    android:padding="2dp">
    <!--  Album Cover links  -->
    <ImageView
        android:id="@+id/image_view_album"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_play_btn"/>
    <!--  Close Button oben rechts  -->
    <FrameLayout
        android:id="@+id/button_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_margin="2dp"
        android:clickable="true">
        <ImageView
            android:id="@+id/image_view_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:srcCompat="@drawable/ic_notif_remove"/>
    </FrameLayout>
    <!--  Titel oben  -->
    <TextView
        android:id="@+id/text_view_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/image_view_album"
        android:layout_toStartOf="@+id/button_close"
        android:layout_alignParentTop="true"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:textColor="@color/lightred"
        android:textSize="10sp"
        android:textStyle="bold"
        android:singleLine="true"
        tools:text="Rauch Haus Song"/>
    <!--  Interpret darunter  -->
    <TextView
        android:id="@+id/text_view_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/image_view_album"
        android:layout_toStartOf="@+id/button_close"
        android:layout_below="@+id/text_view_name"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        android:textColor="@color/lightgreen"
        android:textSize="10sp"
        android:singleLine="true"
        tools:text="Rio Reiser"/>
    <!--  Buttons unten  -->
    <RelativeLayout
        android:id="@+id/layout_play_controls"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_toEndOf="@+id/image_view_album"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="8dp">
        <!--  Previous  -->
        <FrameLayout
            android:id="@+id/button_play_last"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/button_play_toggle"
            android:clickable="true">
            <ImageView
                android:id="@+id/image_view_play_last"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_notif_backward"/>
        </FrameLayout>
        <!--  Play/Pause — Mitte  -->
        <FrameLayout
            android:id="@+id/button_play_toggle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerInParent="true"
            android:clickable="true">
            <ImageView
                android:id="@+id/image_view_play_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_notif_play"/>
        </FrameLayout>
        <!--  Next  -->
        <FrameLayout
            android:id="@+id/button_play_next"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/button_play_toggle"
            android:clickable="true">
            <ImageView
                android:id="@+id/image_view_play_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_notif_forward"/>
        </FrameLayout>
    </RelativeLayout>
</RelativeLayout>