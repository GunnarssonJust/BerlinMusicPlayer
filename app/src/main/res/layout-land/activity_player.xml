<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mContainer"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_player"
    tools:context=".PlayerActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/player_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/darkgreen"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/app_name"
        app:titleTextColor="@color/lightred"/>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- VINYL CONTAINER — links                             -->
    <!-- ════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/vinyl_container"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="2dp"
        android:layout_marginTop="120dp"
        android:layout_marginBottom="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_toolbar"
        app:layout_constraintBottom_toTopOf="@id/RelLayout">

        <ImageView
            android:id="@+id/vinyl_ring"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:src="@drawable/vinyl_record"
            android:contentDescription="@string/albumart"
            android:visibility="invisible"/>

        <ImageView
            android:id="@+id/album_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_play_pressed"
            android:contentDescription="@string/albumart"/>

        <ImageView
            android:id="@+id/vinyl_hole"
            android:visibility="invisible"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:src="@drawable/vinyl_center_hole"
            android:contentDescription="@string/albumart"/>

    </FrameLayout>

    <!-- Tonarm -->
    <ImageView
        android:id="@+id/vinyl_tonearm"
        android:layout_width="90dp"
        android:layout_height="120dp"
        android:src="@drawable/vinyl_tonearm"
        android:visibility="invisible"
        android:contentDescription="@string/albumart"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="38dp"
        app:layout_constraintEnd_toEndOf="@id/vinyl_container"
        app:layout_constraintTop_toTopOf="@id/vinyl_container"/>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- RECHTE SEITE — Titel, Artist, SeekBar, Buttons     -->
    <!-- ════════════════════════════════════════════════════ -->

    <TextView
        android:id="@+id/songTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:ellipsize="marquee"
        android:gravity="start"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:text="@string/rauch_haus_song"
        android:textColor="@color/darkgreen"
        android:textIsSelectable="true"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/vinyl_container"
        app:layout_constraintTop_toBottomOf="@id/player_toolbar"/>

    <TextView
        android:id="@+id/songArtist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:ellipsize="marquee"
        android:gravity="start"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:text="@string/rio_reiser"
        android:textColor="@color/red"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textIsSelectable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/vinyl_container"
        app:layout_constraintTop_toBottomOf="@id/songTitle"/>

    <!-- Zeit links -->
    <TextView
        android:id="@+id/songCurrentDurationLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:gravity="start"
        android:text="@string/start_time"
        android:textColor="@color/red"
        app:layout_constraintStart_toEndOf="@id/vinyl_container"
        app:layout_constraintTop_toBottomOf="@id/songArtist"/>

    <!-- Zeit rechts -->
    <TextView
        android:id="@+id/songRemainingDurationLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:text="@string/end"
        android:textColor="@color/darkgreen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/songArtist"/>

    <!-- SeekBar -->
    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="0dp"
        android:layout_height="25dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:padding="8dp"
        android:progressDrawable="@drawable/seekbar"
        android:thumb="@drawable/ic_seekbar_ampelmann_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/vinyl_container"
        app:layout_constraintTop_toBottomOf="@id/songCurrentDurationLabel"/>

    <!-- Shuffle / Add / Repeat -->
    <ImageView
        android:id="@+id/btn_shuffle"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/shuffle"
        android:src="@drawable/ic_shuffle"
        app:layout_constraintEnd_toStartOf="@+id/btn_add_2_playlist"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toEndOf="@id/vinyl_container"
        app:layout_constraintTop_toBottomOf="@id/seekBar"/>

    <ImageView
        android:id="@+id/btn_add_2_playlist"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/add_to_playlist"
        android:src="@drawable/ic_add_to_playlist"
        app:layout_constraintEnd_toStartOf="@+id/btn_repeat"
        app:layout_constraintStart_toEndOf="@+id/btn_shuffle"
        app:layout_constraintTop_toBottomOf="@id/seekBar"/>

    <ImageView
        android:id="@+id/btn_repeat"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/repeat"
        android:src="@drawable/ic_repeat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_add_2_playlist"
        app:layout_constraintTop_toBottomOf="@id/seekBar"/>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- BERLIN SKYLINE + BUTTONS — volle Breite unten      -->
    <!-- ════════════════════════════════════════════════════ -->
    <RelativeLayout
        android:id="@+id/RelLayout"
        android:layout_width="400dp"
        android:layout_height="80dp"
        android:layout_margin="1dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_color_footer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/teufelsberg"
            android:layout_width="62dp"
            android:layout_height="35dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="-2dp"
            android:layout_marginBottom="14dp"
            android:contentDescription="@string/teufelsberg"
            android:scaleType="fitXY"
            android:src="@drawable/ic_teufelsberg" />

        <!-- Funkturm — ganz links -->

        <!-- Gedächtniskirche — links von Mitte -->


        <ImageView
            android:layout_width="40dp"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="0dp"
            android:contentDescription="@string/funkturm"
            android:scaleType="fitXY"
            android:src="@drawable/funkturm" />

        <ImageView
            android:id="@+id/gedaechtniskirche"
            android:layout_width="70dp"
            android:layout_height="45dp"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="-96dp"
            android:layout_marginBottom="0dp"
            android:layout_toStartOf="@+id/rewind"
            android:scaleType="fitEnd"
            android:src="@drawable/im_gedaechtniskirche" />

        <ImageView
            android:id="@+id/rewind"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="50dp"
            android:layout_toStartOf="@id/play_pause"
            android:contentDescription="@string/rewind"
            android:src="@mipmap/ic_backward" />

        <!-- Play/Pause -->
        <ImageView
            android:id="@+id/play_pause"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            android:src="@mipmap/ic_play_pressed" />

        <!-- Next -->
        <ImageView
            android:id="@+id/forward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="50dp"
            android:layout_toEndOf="@id/play_pause"
            android:contentDescription="@string/forward"
            android:src="@mipmap/ic_forward" />

        <ImageView
            android:id="@+id/auster"
            android:layout_width="35dp"
            android:layout_height="28dp"
            android:layout_alignParentBottom="true"
            android:layout_toEndOf="@+id/gedaechtniskirche"
            android:layout_toStartOf="@id/reichstag"
            android:layout_marginStart="42dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_auster"/>

        <!-- Reichstag — rechts von Mitte -->
        <ImageView
            android:id="@+id/reichstag"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="-52dp"
            android:layout_marginBottom="-4dp"
            android:layout_toEndOf="@+id/forward"
            android:scaleType="fitStart"
            android:src="@drawable/im_reichstag" />

        <!-- Fernsehturm — ganz rechts -->

        <ImageView
            android:layout_width="63dp"
            android:layout_height="73dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="-2dp"
            android:contentDescription="@string/fernsehturm"
            android:scaleType="fitXY"
            android:src="@drawable/ic_fernsehturm" />

        <ImageView
            android:id="@+id/brandenburgertor"
            android:layout_width="35dp"
            android:layout_height="20dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="-1dp"
            android:layout_toEndOf="@+id/reichstag"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_gate_white" />

    </RelativeLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
