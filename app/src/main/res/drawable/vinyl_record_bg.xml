<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Äußerer schwarzer Ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1a1a1a"/>
        </shape>
    </item>
    <!-- Innerer Ring (Cover-Bereich) -->
    <item
        android:bottom="60dp"
        android:left="60dp"
        android:right="60dp"
        android:top="60dp">
        <shape android:shape="oval">
            <solid android:color="#333333"/>
        </shape>
    </item>
    <!-- Mittelloch -->
    <item
        android:bottom="120dp"
        android:left="120dp"
        android:right="120dp"
        android:top="120dp">
        <shape android:shape="oval">
            <solid android:color="#111111"/>
        </shape>
    </item>
</layer-list>